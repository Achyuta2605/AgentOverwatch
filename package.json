{
  "name": "agentoverwatch",
  "version": "0.1.0",
  "description": "A security gateway between AI agents and their MCP tools: blocks poisoned tools, prompt injection and runaway loops, with a local dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentoverwatch": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bench/cases",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts --logLevel warn",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run build && vitest run",
    "dev": "tsx src/cli.ts",
    "dev:ui": "vite --config ui/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Achyuta2605/agentoverwatch.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "security",
    "prompt-injection",
    "gateway",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "hono": "^4.13.19",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
